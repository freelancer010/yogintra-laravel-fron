<IfModule mod_headers.c>
  # Keep this directive on one line. Apache otherwise emits an empty CSP header
  # before Laravel's response reaches the browser.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' blob: https:; connect-src 'self' https:; frame-src 'self' https:; form-action 'self'; upgrade-insecure-requests"

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Hostinger serves Brotli to modern browsers. Keep a gzip/deflate fallback for
# clients and audit tools that do not advertise Brotli support.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Static files are versioned or uploaded under unique filenames. Cache them in
# browsers and Hostinger's edge cache so repeat views do not re-download media.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|mjs|avif|webp|svg|jpe?g|png|gif|mp4|webm|woff2?)$">
    # Apply this even when a hosting-layer rule added a shorter static-file TTL.
    # Assets use immutable upload names or deploy-versioned filenames, so browsers
    # and shared caches can retain them for a full year safely.
    Header always unset Cache-Control
    Header always set Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable"
  </FilesMatch>
</IfModule>


<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    # Force lowercase URLs (e.g. /City/Mumbai → /city/mumbai)
    RewriteMap tolower int:tolower
    RewriteCond %{REQUEST_URI} [A-Z]
    RewriteRule ^(.*)$ ${tolower:%{REQUEST_URI}} [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.yogintra\.com$
    RewriteRule ^/?$ "https\:\/\/yogintra\.com\/" [R=301,L]
</IfModule>
